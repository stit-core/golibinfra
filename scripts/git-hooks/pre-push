#!/usr/bin/env bash
# pre-push: гейт перед отправкой в remote — весь `make check`; CI нет, это последняя проверка.
# make check проверяет рабочее дерево, поэтому пушится только чистый HEAD: иначе незакоммиченная
# правка озеленит сломанный коммит. Включается `make hooks`; без него make check красный.
#
# Обход — только руками человека: git push --no-verify. Из сессии Claude его и смену
# core.hooksPath блокирует хук .claude/hooks/guard-bash.sh.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ -n "$(git status --porcelain)" ]; then
	echo "pre-push: дерево не чистое — make check проверил бы не то, что уходит в remote."
	echo "Закоммить или спрячь изменения (git stash -u):"
	git status --short | sed 's/^/  /'
	exit 1
fi

# stdin: <local ref> <local sha> <remote ref> <remote sha> на каждый пушимый ref.
head=$(git rev-parse HEAD)
while read -r local_ref local_sha _ _; do
	[[ $local_sha =~ ^0+$ ]] && continue # удаление ref: проверять нечего
	if [ "$(git rev-parse "$local_sha^{commit}")" != "$head" ]; then
		echo "pre-push: $local_ref указывает не на HEAD — make check проверяет только HEAD."
		echo "Переключись на пушимый коммит и повтори push."
		exit 1
	fi
done

echo "pre-push: make check"
# Флаги и makefile'ы вызывающего make (MAKEFLAGS=i, -n…) до гейта не доходят.
exec env -u MAKEFLAGS -u MFLAGS -u GNUMAKEFLAGS -u MAKEFILES make check
