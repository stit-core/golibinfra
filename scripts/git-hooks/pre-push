#!/usr/bin/env bash
# pre-push: гейт перед отправкой в remote — `make check` каждого пушимого коммита в свежем
# worktree (scripts/gate-clean.sh); CI нет, это последняя проверка. Вердикт — про то, что
# уходит в remote: незакоммиченные правки и gitignored-файлы рабочего дерева на него не
# влияют. Включается `make hooks`; без него make check красный.
#
# Обход — только руками человека: git push --no-verify. Из сессии Claude его и смену
# core.hooksPath блокируют .claude/settings.json и хук .claude/hooks/guard-bash.sh.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# stdin: <local ref> <local sha> <remote ref> <remote sha> на каждый пушимый ref.
checked=" "
while read -r local_ref local_sha _ _; do
	[[ $local_sha =~ ^0+$ ]] && continue # удаление ref: проверять нечего
	commit=$(git rev-parse "$local_sha^{commit}")
	[[ $checked == *" $commit "* ]] && continue # main и тег на одном коммите — один прогон
	checked+="$commit "
	echo "pre-push: $local_ref — make check в свежем worktree"
	# stdin гейта — не список ref'ов: его дочитывает цикл.
	scripts/gate-clean.sh "$commit" </dev/null
done
